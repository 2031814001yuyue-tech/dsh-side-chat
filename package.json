{
  "name": "dsh-side-chat",
  "version": "0.1.0",
  "description": "DSH Side Chat — 并行侧边对话插件：真实并行 agent 会话、独立上下文、摘要带回主对话。",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node scripts/check.cjs",
    "build": "node scripts/build-npm.mjs",
    "smoke": "node scripts/smoke-npm.mjs",
    "prepublishOnly": "npm run check && npm run build && npm run smoke"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
